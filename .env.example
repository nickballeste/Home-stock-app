# ── Database ─────────────────────────────────────────────────────
# Special chars in the password MUST be URL-encoded (/ → %2F, $ → %24, + → %2B)
# Pooled connection (PgBouncer, port 6543 on Supabase) — used by the app at runtime
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Local development only: bypasses login entirely.
# Ignored when NODE_ENV=production — safe to forget.
AUTH_DISABLED="true"

# The first signup becomes the household owner; after that, signups are
# closed. Set to "true" to let more people create accounts (e.g. a partner).
# ALLOW_SIGNUPS="true"

# Optional: comma-separated static API keys for external clients
# (e.g. the future WhatsApp agent). Clients pass them via the X-API-Key header.
HOMESTOCK_API_KEYS=""

# ── AI ───────────────────────────────────────────────────────────
# Required for AI features (duration inference, routine extraction, photo
# import). The rest of the app works without it.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the Claude model.
# ANTHROPIC_MODEL="claude-sonnet-5"

# ── Email (optional) ─────────────────────────────────────────────
# Without RESEND_API_KEY the digest runs but no email is actually sent.
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="homestock@example.com"

# ── Cron ─────────────────────────────────────────────────────────
# Set automatically by Vercel in production; any value works locally.
CRON_SECRET="local-dev-cron-secret"

# ── App ──────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
WEB_ORIGIN="http://localhost:5173"
