# Database — special chars in password MUST be URL-encoded (/ → %2F, $ → %24, + → %2B)
# Pooled connection (PgBouncer) — used by the app at runtime
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection — used by Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth
JWT_SECRET="tokentoken"
API_KEY_SALT="change-me"

# AI
ANTHROPIC_API_KEY="sk-ant..."

# Email
RESEND_API_KEY="re_..."
DIGEST_FROM_EMAIL="...@email.com"

# Cron (set automatically by Vercel in production)
CRON_SECRET="local-dev-cron-secret"

# App
NODE_ENV="development"
PORT=3001
WEB_ORIGIN="http://localhost:5173"

# Auth
# Set AUTH_DISABLED=true for local development to bypass auth.
AUTH_DISABLED="true"

# Optional: comma-separated static API keys for external clients (e.g. WhatsApp).
# Clients pass these via the X-API-Key header.
HOMESTOCK_API_KEYS=""

# Optional: override the Claude model.
# ANTHROPIC_MODEL="claude-sonnet-4-6"
