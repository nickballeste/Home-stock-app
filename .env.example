# Database (Supabase pooled connection)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Auth
JWT_SECRET="change-me-to-a-strong-secret"
API_KEY_SALT="change-me"

# AI
ANTHROPIC_API_KEY="sk-ant-..."

# Email
RESEND_API_KEY="re_..."
DIGEST_FROM_EMAIL="homestock@example.com"

# Cron (set automatically by Vercel in production)
CRON_SECRET="local-dev-cron-secret"

# App
NODE_ENV="development"
PORT=3001
WEB_ORIGIN="http://localhost:5173"

# Auth
# Set AUTH_DISABLED=true for local development to bypass auth.
AUTH_DISABLED="true"

# Optional: comma-separated static API keys for external clients (e.g. WhatsApp).
# Clients pass these via the X-API-Key header.
HOMESTOCK_API_KEYS=""

# Optional: override the Claude model.
# ANTHROPIC_MODEL="claude-sonnet-4-6"
